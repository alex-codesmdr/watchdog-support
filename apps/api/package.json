{
  "name": "@wd/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && rm -rf dist/db/migrations && cp -r db/migrations dist/db/migrations",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "start": "node dist/src/main.js",
    "start:worker": "node dist/src/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:migrate": "tsx --env-file-if-exists=../../.env db/migrate.ts up",
    "db:rollback": "tsx --env-file-if-exists=../../.env db/migrate.ts down",
    "db:status": "tsx --env-file-if-exists=../../.env db/migrate.ts status",
    "db:seed": "tsx --env-file-if-exists=../../.env db/seed.ts",
    "openapi": "tsx src/openapi/emit.ts > openapi.json",
    "migrate:prod": "node dist/db/migrate.js up",
    "seed:prod": "node dist/db/seed.js"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/lib-storage": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@tus/file-store": "^2.1.2",
    "@tus/s3-store": "^2.1.0",
    "@tus/server": "^2.4.7",
    "@wd/config": "workspace:*",
    "@wd/contracts": "workspace:*",
    "@wd/rbac": "workspace:*",
    "@wd/sla-time": "workspace:*",
    "altcha-lib": "^1.4.1",
    "bullmq": "^5.81.5",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "file-type": "^21.3.4",
    "helmet": "^8.3.0",
    "imapflow": "^1.7.8",
    "ioredis": "^5.11.1",
    "jose": "^6.2.15",
    "kysely": "^0.28.19",
    "mailparser": "^3.14.1",
    "marked": "^16.4.2",
    "mjml": "^5.4.1",
    "nodemailer": "^10.3.1",
    "pdfkit": "0.17.2",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "prom-client": "^15.1.3",
    "rate-limiter-flexible": "^7.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.18.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.8",
    "@swc/core": "^1.16.21",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/mailparser": "^3.9.0",
    "@types/mjml": "^5.4.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "0.17.3",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@wd/brand-lint": "workspace:*",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "unplugin-swc": "^2.0.0"
  }
}
