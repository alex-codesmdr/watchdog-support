# ---- Local development (docker compose provides these services). Never commit real secrets. ----
NODE_ENV=development
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000

# API (app role: subject to row-level security) and migrations (owner role)
DATABASE_URL=postgres://wd_app:wd_app_dev@localhost:5432/watchdog
DATABASE_OWNER_URL=postgres://wd_owner:wd_owner_dev@localhost:5432/watchdog
REDIS_URL=redis://localhost:6379

# Identity (Keycloak realm "watchdog")
AUTH_ISSUER=http://localhost:8080/realms/watchdog
AUTH_AUDIENCE=wd-api
AUTH_MFA_ACR_VALUES=mfa,2
AUTH_REQUIRE_MFA=true
IDENTITY_PROVISIONER=mock
KEYCLOAK_ADMIN_URL=http://localhost:8080
KEYCLOAK_REALM=watchdog
KEYCLOAK_ADMIN_CLIENT_ID=wd-provisioner
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me-provisioner

# Web BFF
API_INTERNAL_URL=http://localhost:4000
OIDC_ISSUER=http://localhost:8080/realms/watchdog
OIDC_CLIENT_ID=wd-web
OIDC_CLIENT_SECRET=change-me-web-client
SESSION_REDIS_URL=redis://localhost:6379
SESSION_COOKIE_SECURE=false

# Files: 's3' with MinIO in compose, 'fs' for bare-metal dev
STORAGE_DRIVER=fs
STORAGE_FS_ROOT=./data/objects
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=wd-minio
S3_SECRET_KEY=wd-minio-secret
UPLOAD_MAX_BYTES=2147483648
AV_MODE=skip
CLAMAV_HOST=
CLAMAV_PORT=3310

# 32+ random chars: `openssl rand -base64 48`
APP_SIGNING_KEY=dev-only-signing-key-replace-me-0123456789abcdef

# Mail (Mailpit in compose: UI on http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="WatchDog Support <support@watchdog.example>"
MAIL_REPLY_DOMAIN=support.watchdog.example

# Brand lint: never commit the list. Locally, put terms one per line in .brand-terms (gitignored).
WD_PROHIBITED_TERMS_FILE=.brand-terms
