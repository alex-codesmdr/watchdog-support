{
  "name": "watchdog-support",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @wd/api test:integration",
    "db:migrate": "pnpm --filter @wd/api db:migrate",
    "db:rollback": "pnpm --filter @wd/api db:rollback",
    "db:seed": "pnpm --filter @wd/api db:seed",
    "brand-lint": "node packages/brand-lint/dist/cli.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "fast-check": "^4.10.2",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "overrides": {
      "multer": "^2.5.0",
      "next>postcss": "^8.5.18",
      "postcss": "^8.5.18",
      "exceljs>uuid": "^11.1.1"
    }
  }
}
